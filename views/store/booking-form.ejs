 <%- include('../partials/head') %>
</head>

<body>
  <%- include('../partials/nav') %>

  <% if(typeof error !== "undefined") { %>

  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-5">
      <%= error %>
  </div>

<% } %>
    <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md">

        <h1 class="text-3xl font-bold mb-6 text-center text-red-500">
            Book Your Stay
        </h1>

        <form action="/book/<%= home._id %>" method="POST" class="max-w-md mx-auto">

            <input
                type="text"
                value="<%= home.houseName %>"
                readonly
                class="w-full px-4 py-2 mb-4 border rounded-md bg-gray-100"
            >

            <input
                type="text"
                value="₹<%= home.price %> / night"
                readonly
                class="w-full px-4 py-2 mb-4 border rounded-md bg-gray-100"
            >

            <input
                type="text"
                name="name"
                value="<%= user.firstName %> <%= user.lastName %>"
                readonly
                class="w-full px-4 py-2 mb-4 border rounded-md bg-gray-100"
            >

            <input
                type="email"
                name="email"
                value="<%= user.email %>"
                readonly
                class="w-full px-4 py-2 mb-4 border rounded-md bg-gray-100"
            >

            <input
                type="text"
                name="mobile"
                placeholder="Enter Mobile Number"
                required
                class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
            >

            <label class="font-semibold">Check In</label>

            <input
                type="date"
                name="checkIn"
                min="<%= new Date().toISOString().split('T')[0] %>"
                required
                class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
            >

            <label class="font-semibold">Check Out</label>

            <input
                type="date"
                name="checkOut"
                min="<%= new Date().toISOString().split('T')[0] %>"
                required
                class="w-full px-4 py-2 mb-6 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
            >

            <button
                type="submit"
                class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300"
            >
                Book Now
            </button>

        </form>

    </main>

</body>

</html>